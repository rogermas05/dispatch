# ─────────────────────────────────────────────────────────────────────────────
# token-origins — environment template
#
# Copy to .env.local and `chmod 600 .env.local`.
# NEVER commit the filled-in version. NEVER paste a wallet seed into a chat.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Network ─────────────────────────────────────────────────────────────────
NETWORK=Preprod

# ─── Blockfrost (Cardano chain indexer) ──────────────────────────────────────
# Free key, must be scoped to Preprod: https://blockfrost.io
BLOCKFROST_API_KEY_PREPROD=

# ─── Sokosumi (marketplace) ──────────────────────────────────────────────────
# Human/setup credential: OAuth via `sokosumi --preprod auth login`, or a user API
# key here. SOKOSUMI_API_KEY overrides saved OAuth credentials — clear it from the
# shell before switching accounts.
SOKOSUMI_API_KEY=
SOKOSUMI_COWORKER_ID=
SOKOSUMI_VENDOR_ID=
SOKOSUMI_WORKSPACE_ID=
# TOKEN2049 event organization (Phase 6). Published on the event setup page.
SOKOSUMI_EVENT_WORKSPACE_ID=01a109d1-32a9-71a3-a0e3-658b2a7987cd

# Coworker-scoped runtime key — SEPARATE credential tier from the above. Imported
# via `sokosumi runtime key-import`; never substitute human OAuth for runtime auth.
SOKOSUMI_RUNTIME_KEY=

# ─── Model provider: Anthropic ───────────────────────────────────────────────
# The agent's reasoning at runtime. Billed separately from Workspace credits —
# this is our cost of goods sold against the USDM we collect.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5-5

# ─── Telephony: Telnyx (Phase 2T) ────────────────────────────────────────────
# Telnyx AI Assistants run the real-time voice loop; Dispatch supplies intent
# and reads back the transcript. Set to "mock" to run the pipeline without
# placing real calls.
TELEPHONY_PROVIDER=telnyx
TELNYX_API_KEY=
# TeXML application that places outbound AI calls (portal -> Voice -> TeXML Apps)
TELNYX_TEXML_APP_ID=
# Verified Telnyx number to dial from, E.164
TELNYX_FROM_NUMBER=
# Optional overrides
TELNYX_MODEL=
# Voice is config, not code. Any Telnyx voice id works. For ElevenLabs:
#   TELNYX_VOICE=elevenlabs.eleven_turbo_v2_5.<voice_id>
#   TELNYX_VOICE_API_KEY_REF=<Telnyx integration secret holding a premium
#                             ElevenLabs API key; POST /v2/integration_secrets>
TELNYX_VOICE=
TELNYX_VOICE_API_KEY_REF=

# ─── Who Dispatch may call ───────────────────────────────────────────────────
# Comma-separated E.164 numbers. With real telephony an EMPTY list means Dispatch
# refuses every job (fail closed). Only lines we own or that have consented —
# the Telnyx account is shared with a production healthcare system.
DISPATCH_ALLOWED_NUMBERS=
# Where recordings live. Result files are capped at 1 MiB, so audio is stored
# externally and referenced from the transcript.
RECORDING_STORAGE_URL=

# ─── iMessage payments (apps/imessage) ───────────────────────────────────────
# Off unless STRIPE_SECRET_KEY is set; calls over iMessage are then free.
# With it set, a texter pays through a Stripe Checkout link (Apple Pay) into a
# prepaid balance, and each call is charged the agent's quote (1 tUSDM = $1).
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint for checkout.session.completed,
# pointed at {PAYMENTS_PUBLIC_URL}/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Public https origin that reaches the iMessage bot (IMESSAGE_BOT_PORT).
PAYMENTS_PUBLIC_URL=
# Whole cents. Stripe takes roughly 2.9% + 30c per charge, so keep top-ups large.
IMESSAGE_TOPUP_CENTS=500
# Balances live here. Back it up: it is the only record of what people have paid.
# Defaults to .local/imessage-ledger.jsonl.
IMESSAGE_LEDGER_FILE=

# ─── Masumi Payment Service (MPS) ────────────────────────────────────────────
# WARNING: ENCRYPTION_KEY *is* the seller wallet. Lose it or reseed on resume
# and the registry NFT is gone permanently — the agent can never be
# deregistered. Back it up outside this repo before Phase 3.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/masumi_payment
ENCRYPTION_KEY=
ADMIN_KEY=
# MPS listens on 3012; admin UI at http://127.0.0.1:3012/admin/
MPS_PORT=3012
PAYMENT_SERVICE_URL=http://localhost:3012/api/v1
# Scoped read+pay key for the agent API (`node scripts/register-agent.mjs key`).
# Falls back to ADMIN_KEY if unset; don't run production on the admin key.
MPS_PAY_KEY=
# V2 payment source; the index of our pricing in supported_payment_sources.
PAYMENT_SOURCE_TYPE=Web3CardanoV2
SUPPORTED_PAYMENT_SOURCE_INDEX=0
# Only if MPS has more than one Preprod V2 payment source (registration script).
PAYMENT_SOURCE_ID=

# ─── Hiring other agents (research before calls) ─────────────────────────────
# Dispatch can hire research agents on Masumi, paid from a budget the hirer adds
# to the job price. Off unless all three are set and PRICING=dynamic.
# Comma-separated agent identifiers Dispatch may hire (vetted, fixed-price agents).
DISPATCH_RESEARCH_AGENTS=
# Spending-capped purchase key: `node scripts/register-agent.mjs buyer-key`.
# Needs a funded Purchasing wallet (tUSDM for hires + ADA for fees).
MPS_BUY_KEY=
# Total the buyer key may ever spend (enforced by the payment service).
BUYER_SPEND_CAP_USDM=10
# Largest research budget a single hirer may grant, and how long to wait for it.
RESEARCH_BUDGET_MAX_USDM=2
RESEARCH_TIMEOUT_MINUTES=10

# ─── Our MIP-003 agent API (Shape A) ─────────────────────────────────────────
# Distinct from MPS above: 3013 is our agent API, 3012 is the payment service.
AGENT_API_PORT=3013
AGENT_API_BASE_URL=http://localhost:3013
# The stable public https URL minted into the registry NFT. Set before registering.
AGENT_API_PUBLIC_URL=
# Protects the operator-only GET /jobs route. Buyer routes (/start_job, /status,
# /input_schema, /availability) are always public: buyers never hold this token.
AGENT_API_TOKEN=
# Durable job state. Must be on a persistent volume in production (/data in Docker).
JOBS_DIR=
RUNNER_INTERVAL_MS=15000
MAX_CONCURRENT_CALLS=2

# ─── Masumi identity (populated at Phase 3 registration) ─────────────────────
AGENT_IDENTIFIER=
POLICY_ID=
SELLER_VKEY=
SELLER_ADDRESS=

# ─── Pricing ─────────────────────────────────────────────────────────────────
# Preprod test USDM token unit, per the reference implementation
USDM_UNIT=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d
TASK_PRICE_USDM=1
# Roughly EUR 0.05-7 per call depending on expected duration.
# PRICING=dynamic sends TASK_PRICE_USDM with each payment request; fixed defers
# to the registry entry.
PRICING=dynamic
# Escrow windows, minutes from start_job. Calls can run 30 min, so keep
# submit-result well after pay-by. A shorter unlock means faster collection.
ESCROW_PAY_BY_MINUTES=15
ESCROW_SUBMIT_RESULT_MINUTES=60
ESCROW_UNLOCK_MINUTES=90
ESCROW_EXTERNAL_DISPUTE_MINUTES=150
