{
  "name": "token-origins",
  "version": "1.0.0",
  "description": "Dispatch - a voice agent that makes phone calls for humans and other AI agents, paid on-chain via Masumi.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run dev -w @token-origins/web",
    "build": "npm run build -w @token-origins/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mock:feed": "npm run mock:feed -w @token-origins/web",
    "agent:api": "npm run agent:api -w @token-origins/agent-api",
    "worker": "npm run worker -w @token-origins/worker",
    "verify:receipt": "node scripts/verify-seller-receipt.mjs",
    "feed:emit": "node --experimental-strip-types scripts/emit-feed.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogermas05/token-origins.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rogermas05/token-origins/issues"
  },
  "homepage": "https://github.com/rogermas05/token-origins#readme",
  "devDependencies": {
    "@masumi_network/sokosumi": "^1.0.4",
    "@railway/cli": "^5.63.4"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
