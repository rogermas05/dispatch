{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "preprod"
      ]
    },
    "network": {
      "type": "string",
      "const": "Preprod"
    },
    "asset": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      },
      "required": [
        "symbol",
        "unit",
        "decimals"
      ]
    },
    "platform_fee_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "broker",
              "storefront",
              "producer",
              "customer"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "masumi_agent_identifier": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "provider",
          "masumi_agent_identifier"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sokosumi_task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "producer_id": {
            "type": "string",
            "minLength": 1
          },
          "search": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "hits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "experience_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "components": {
                      "type": "object",
                      "properties": {
                        "relevance": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "context_match": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "observed_success": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "evidence_quality": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "freshness": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "creator_reliability": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "relevance",
                        "context_match",
                        "observed_success",
                        "evidence_quality",
                        "freshness",
                        "creator_reliability"
                      ]
                    },
                    "compatible": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "experience_id",
                    "score",
                    "components",
                    "compatible"
                  ]
                }
              },
              "decision": {
                "type": "string",
                "enum": [
                  "purchase",
                  "cold_start",
                  "reuse_entitled"
                ]
              },
              "chosen_experience_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "query",
              "hits",
              "decision",
              "chosen_experience_id"
            ]
          },
          "metrics": {
            "type": "object",
            "properties": {
              "tool_calls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failed_tool_calls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "compute_cost_usd": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "tool_calls",
              "failed_tool_calls",
              "tokens",
              "duration_ms",
              "compute_cost_usd"
            ]
          },
          "baseline": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tool_calls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "failed_tool_calls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "compute_cost_usd": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "tool_calls",
                  "failed_tool_calls",
                  "tokens",
                  "duration_ms",
                  "compute_cost_usd"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "result_summary": {
            "type": "string"
          },
          "published_experience_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "sokosumi_task_id",
          "title",
          "brief",
          "producer_id",
          "search",
          "metrics",
          "baseline",
          "result_summary",
          "published_experience_id"
        ]
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "creator_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "seeded": {
            "type": "boolean"
          },
          "problem": {
            "type": "string"
          },
          "teaser": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "self_report",
              "artifact",
              "evaluator"
            ]
          },
          "parents": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "experience_id": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "experience_id",
                "digest"
              ]
            }
          },
          "split": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recipient_id": {
                  "type": "string",
                  "minLength": 1
                },
                "bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "required": [
                "recipient_id",
                "bps"
              ]
            }
          },
          "price": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        },
        "required": [
          "id",
          "digest",
          "creator_id",
          "task_id",
          "seeded",
          "problem",
          "teaser",
          "context",
          "evidence_level",
          "parents",
          "split",
          "price"
        ]
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "buyer_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "experience_id": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "collected_amount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "platform_fee": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "buyer_id",
          "task_id",
          "experience_id",
          "amount",
          "collected_amount",
          "platform_fee"
        ]
      }
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "recipient_id": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "payout_receipt_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "order_id",
          "recipient_id",
          "amount",
          "payout_receipt_id"
        ]
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "registration",
              "funds_locked",
              "result_submitted",
              "collection",
              "payout",
              "anchor"
            ]
          },
          "tx_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "reported",
              "mock"
            ]
          },
          "explorer_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "tx_hash",
          "verification",
          "explorer_url"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent_registered",
              "task_received",
              "search_completed",
              "tool_call",
              "result_evaluated",
              "result_delivered",
              "experience_published",
              "order_placed",
              "funds_locked",
              "content_delivered",
              "payment_collected",
              "royalty_allocated",
              "payout_confirmed"
            ]
          },
          "label": {
            "type": "string"
          },
          "ok": {
            "default": true,
            "type": "boolean"
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "experience_id": {
            "type": "string",
            "minLength": 1
          },
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "allocation_id": {
            "type": "string",
            "minLength": 1
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "seq",
          "at",
          "kind",
          "label"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "mode",
    "network",
    "asset",
    "platform_fee_bps",
    "agents",
    "tasks",
    "experiences",
    "orders",
    "allocations",
    "receipts",
    "events"
  ]
}
