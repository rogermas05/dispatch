{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "preprod"
      ]
    },
    "network": {
      "type": "string",
      "const": "Preprod"
    },
    "asset": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      },
      "required": [
        "symbol",
        "unit",
        "decimals"
      ]
    },
    "dispatch": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "agent_identifier": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "voice_provider": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "agent_identifier",
        "voice_provider"
      ]
    },
    "hirers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ]
          },
          "via": {
            "type": "string",
            "enum": [
              "sokosumi",
              "masumi"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "via",
          "description"
        ]
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "phone_masked": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone_masked"
        ]
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "hirer_id": {
            "type": "string",
            "minLength": 1
          },
          "party_id": {
            "type": "string",
            "minLength": 1
          },
          "sokosumi_task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "blockchain_identifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "hirer_task": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "resolution": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "resolution"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "input": {
            "type": "object",
            "properties": {
              "to": {
                "type": "string"
              },
              "objective": {
                "type": "string"
              },
              "authorization": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "max_duration_seconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "to",
              "objective",
              "authorization"
            ]
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "price": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "deadlines": {
            "type": "object",
            "properties": {
              "pay_by": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "submit_result_by": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "unlock_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "external_dispute_unlock_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "pay_by",
              "submit_result_by",
              "unlock_at",
              "external_dispute_unlock_at"
            ]
          },
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "unreachable",
                      "refused",
                      "escalated",
                      "timeout"
                    ]
                  },
                  "durationSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "transcript": {
                    "type": "object",
                    "properties": {
                      "turns": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "speaker": {
                              "type": "string",
                              "enum": [
                                "agent",
                                "other"
                              ]
                            },
                            "text": {
                              "type": "string"
                            },
                            "atSeconds": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "speaker",
                            "text",
                            "atSeconds"
                          ]
                        }
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "turns",
                      "text"
                    ]
                  },
                  "recordingUrl": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "providerCallId": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "artifacts": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "humanFollowUp": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "caveats": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "status",
                  "durationSeconds",
                  "transcript",
                  "recordingUrl",
                  "providerCallId",
                  "summary",
                  "artifacts",
                  "humanFollowUp",
                  "caveats"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "output_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "hirer_id",
          "party_id",
          "sokosumi_task_id",
          "blockchain_identifier",
          "hirer_task",
          "input",
          "input_hash",
          "price",
          "deadlines",
          "result",
          "output_hash"
        ]
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "registration",
              "funds_locked",
              "result_submitted",
              "collection"
            ]
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "tx_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "reported",
              "mock"
            ]
          },
          "explorer_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "job_id",
          "tx_hash",
          "verification",
          "explorer_url"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent_registered",
              "registry_search",
              "job_started",
              "funds_locked",
              "brief_parsed",
              "dialing",
              "transcript_turn",
              "on_hold",
              "call_ended",
              "outcome_ready",
              "result_submitted",
              "result_delivered",
              "hirer_resumed",
              "payment_collected"
            ]
          },
          "label": {
            "type": "string"
          },
          "ok": {
            "default": true,
            "type": "boolean"
          },
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "turn_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "seq",
          "at",
          "kind",
          "label"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "mode",
    "network",
    "asset",
    "dispatch",
    "hirers",
    "parties",
    "jobs",
    "receipts",
    "events"
  ]
}
